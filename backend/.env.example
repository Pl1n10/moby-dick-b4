# ── Backend (Express) ─────────────────────────────────────
# Copy to .env and fill in values from the Entra app registration.

# Master switch — keep "false" until the Entra app registration exists.
# When false, requireAuth middleware is a no-op and any caller can hit /api.
AUTH_ENABLED=false

# Mauden tenant directory (GUID). Same value as VITE_AZURE_TENANT_ID.
AZURE_TENANT_ID=

# Application (client) ID. Same value as VITE_AZURE_CLIENT_ID.
AZURE_CLIENT_ID=

# Audience the backend will accept in JWT tokens. Defaults to api://<client-id>
# if left empty. Override only if the Entra app registration uses a custom
# Application ID URI.
AZURE_API_AUDIENCE=

# Postgres connection (already used by db.js — listed here for completeness).
# DATABASE_URL=postgres://moby:moby@db:5432/mobydick

# ── Assignment notifications ──────────────────────────────
# Power Automate "When a HTTP request is received" trigger URL. When a task is
# assigned to an owner, the backend POSTs a JSON payload here and the Flow
# delivers it (email / Teams). Leave empty to disable notifications entirely.
# Treat as a secret: the URL itself is the credential. Never commit it.
NOTIFY_WEBHOOK_URL=

# Public URL of the app, embedded in the notification payload as a link back to
# the board. Defaults to https://kanbanops.mauden.com if left empty.
APP_PUBLIC_URL=
