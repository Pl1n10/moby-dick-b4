# ── Backend (Express) ─────────────────────────────────────
# Copy to .env and fill in values from the Entra app registration.

# Master switch — keep "false" until the Entra app registration exists.
# When false, requireAuth middleware is a no-op and any caller can hit /api.
AUTH_ENABLED=false

# Mauden tenant directory (GUID). Same value as VITE_AZURE_TENANT_ID.
AZURE_TENANT_ID=

# Application (client) ID. Same value as VITE_AZURE_CLIENT_ID.
AZURE_CLIENT_ID=

# Audience the backend will accept in JWT tokens. Defaults to api://<client-id>
# if left empty. Override only if the Entra app registration uses a custom
# Application ID URI. With VITE_AUTH_USE_ID_TOKEN=true (stopgap, ID token as
# bearer) set it to the bare client ID: that is the ID token's audience.
AZURE_API_AUDIENCE=

# ── Login mode ────────────────────────────────────────────
# entra  = Microsoft only (default)
# local  = email + password only, checked against the users table (only
#          emails already in users can log in)
# hybrid = Microsoft for the accounts of ENTRA_DOMAINS, email + password for
#          everyone else (external colleagues outside the tenant)
# Must match VITE_AUTH_MODE on the frontend. local and hybrid need
# LOCAL_AUTH_SECRET.
AUTH_MODE=entra
# hybrid only, required: comma-separated domains that must sign in with
# Microsoft. Their passwords (and password sessions) stop working.
ENTRA_DOMAINS=
# Signs the session tokens. At least 32 characters; the API refuses to start
# without it in local mode. Generate with: openssl rand -hex 32
# Changing it logs everyone out. Secret: never commit it.
LOCAL_AUTH_SECRET=
# Until this moment (ISO 8601, e.g. 2026-11-13T18:00:00+01:00) users without a
# password choose their own at first access; afterwards only a superadmin can
# give one (console → Utenti → Nuova password). Empty = window closed.
LOCAL_AUTH_CLAIM_UNTIL=

# How many proxies append to X-Forwarded-For in front of the API (default 2:
# Mauden reverse proxy, then nginx). The client IP used for the per-IP limit
# and the audit log is the entry that many places from the right; the left
# end is whatever the client sent and can be forged.
TRUST_PROXY_HOPS=2

# Postgres connection (already used by db.js — listed here for completeness).
# DATABASE_URL=postgres://moby:moby@db:5432/mobydick

# ── Assignment notifications ──────────────────────────────
# Power Automate "When a HTTP request is received" trigger URL. When a task is
# assigned to an owner, the backend POSTs a JSON payload here and the Flow
# delivers it (email / Teams). Leave empty to disable notifications entirely.
# Treat as a secret: the URL itself is the credential. Never commit it.
NOTIFY_WEBHOOK_URL=

# Public URL of the app, embedded in the notification payload as a link back to
# the board. Defaults to https://kanbanops.mauden.com if left empty.
APP_PUBLIC_URL=
