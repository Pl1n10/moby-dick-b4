# ── Frontend (Vite) ──────────────────────────────────────
# Copy to .env.local and fill in values from the Entra app registration.

# Master switch — keep "false" until the Entra app registration exists.
# When false the app runs in demo mode (no login required, /api calls go out
# without an Authorization header).
VITE_AUTH_ENABLED=false

# Mauden tenant directory (GUID). Found in Entra ID → Overview → Tenant ID.
VITE_AZURE_TENANT_ID=

# Application (client) ID of the SPA registration.
VITE_AZURE_CLIENT_ID=

# Where Microsoft sends the user back after login. Must match a redirect URI
# configured on the app registration (type: SPA).
#   dev:  http://localhost:5173
#   prod: https://kanbanops.mauden.com
VITE_AZURE_REDIRECT_URI=http://localhost:5173

# Scope of the custom backend API exposed by the app registration.
# Format: api://<client-id>/access_as_user
VITE_AZURE_API_SCOPE=
